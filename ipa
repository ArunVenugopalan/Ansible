Keytab-only, single account, vault needed on bootstrap runs only.

**ipa.yml**

```yaml
---
- name: FreeIPA server
  hosts: ipaserver
  become: true
  gather_facts: false

  pre_tasks:
    - name: Ensure Kerberos Python bindings present
      ansible.builtin.dnf:
        name: python3-gssapi
        state: present
      tags: [always]

  roles:
    - role: freeipa_install
      tags: [never, bootstrap]
      environment:
        KRB5CCNAME: "{{ ipa_ccache }}"

    - role: freeipa_config
      tags: [config, bootstrap]
      environment:
        KRB5CCNAME: "{{ ipa_ccache }}"

  post_tasks:
    - name: Destroy credential cache
      ansible.builtin.command:
        cmd: kdestroy -c {{ ipa_ccache }}
      changed_when: false
      failed_when: false
      tags: [always]
```

**roles/freeipa_install/defaults/main.yml**

```yaml
---
ipaserver_realm: SBOX.TEST
ipaserver_domain: sbox.test
ipa_bootstrap_vault: "{{ playbook_dir }}/vault/ipa-bootstrap.yml"

# true: repair stale keytab automatically. Set false in prod so drift surfaces.
svc_ansible_rekey_on_drift: true
```

**roles/freeipa_install/tasks/main.yml**

```yaml
---
- name: Load bootstrap credentials
  ansible.builtin.include_vars:
    file: "{{ ipa_bootstrap_vault }}"
  no_log: true

- name: Install IPA server
  ansible.builtin.include_role:
    name: freeipa.ansible_freeipa.ipaserver
  vars:
    ipaadmin_password: "{{ enc_ipa_admin_password }}"
    ipadm_password: "{{ enc_ipa_dm_password }}"

# KDC exists only after the install above
- name: Obtain admin TGT
  ansible.builtin.shell:
    cmd: kinit admin
    stdin: "{{ enc_ipa_admin_password }}"
  no_log: true
  changed_when: false

- name: Ensure automation account exists
  freeipa.ansible_freeipa.ipauser:
    name: "{{ svc_ansible_principal }}"
    first: Ansible
    last: Automation

- name: Clear password expiry on automation account
  ansible.builtin.command:
    cmd: >-
      ipa user-mod {{ svc_ansible_principal }}
      --setattr krbPasswordExpiration=20380119031407Z
  changed_when: true

- name: Add automation account to admins
  freeipa.ansible_freeipa.ipagroup:
    name: admins
    user:
      - "{{ svc_ansible_principal }}"
    action: member

- name: Ensure automation keytab directory exists
  ansible.builtin.file:
    path: "{{ svc_ansible_keytab | dirname }}"
    state: directory
    owner: root
    group: root
    mode: "0700"

# Own ccache, or this clobbers the admin TGT obtained above
- name: Test existing automation keytab
  ansible.builtin.command:
    cmd: kinit -kt {{ svc_ansible_keytab }} {{ svc_ansible_principal }}
  environment:
    KRB5CCNAME: "FILE:/tmp/krb5cc_keytab_probe"
  register: svc_ansible_kt_test
  failed_when: false
  changed_when: false

- name: Discard probe cache
  ansible.builtin.command:
    cmd: kdestroy -c FILE:/tmp/krb5cc_keytab_probe
  changed_when: false
  failed_when: false

- name: Fail on unexpected keytab drift
  ansible.builtin.fail:
    msg: >-
      Keytab at {{ svc_ansible_keytab }} no longer authenticates.
      Something re-keyed {{ svc_ansible_principal }}.
      Check the 389-DS access log, then re-run with
      -e svc_ansible_rekey_on_drift=true once understood.
  when:
    - svc_ansible_kt_test.rc != 0
    - not svc_ansible_rekey_on_drift | bool

- name: Re-key automation account
  when:
    - svc_ansible_kt_test.rc != 0
    - svc_ansible_rekey_on_drift | bool
  block:
    - name: Remove stale keytab
      ansible.builtin.file:
        path: "{{ svc_ansible_keytab }}"
        state: absent

    - name: Extract automation keytab
      ansible.builtin.command:
        cmd: >-
          ipa-getkeytab -p {{ svc_ansible_principal }}
          -k {{ svc_ansible_keytab }}
      changed_when: true

    - name: Secure automation keytab
      ansible.builtin.file:
        path: "{{ svc_ansible_keytab }}"
        owner: root
        group: root
        mode: "0600"

- name: Switch to automation identity
  ansible.builtin.command:
    cmd: kinit -kt {{ svc_ansible_keytab }} {{ svc_ansible_principal }}
  changed_when: false
```

