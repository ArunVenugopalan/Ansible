**roles/freeipa_install/tasks/main.yml**

```yaml
---
- name: Load bootstrap credentials
  ansible.builtin.include_vars:
    file: "{{ ipa_bootstrap_vault }}"
  no_log: true

- name: Install IPA server
  ansible.builtin.include_role:
    name: freeipa.ansible_freeipa.ipaserver
  vars:
    ipaadmin_password: "{{ enc_ipa_admin_password }}"
    ipadm_password: "{{ enc_ipa_dm_password }}"

# KDC exists only after the install above
- name: Obtain admin TGT
  ansible.builtin.shell:
    cmd: kinit admin
    stdin: "{{ enc_ipa_admin_password }}"
  no_log: true
  changed_when: false

- name: Ensure automation account exists
  freeipa.ansible_freeipa.ipauser:
    name: "{{ svc_ansible_principal }}"
    first: Ansible
    last: Automation

- name: Ensure automation accounts group exists
  freeipa.ansible_freeipa.ipagroup:
    name: automation-accounts
    user:
      - "{{ svc_ansible_principal }}"

# Persistent fix — stops any future expiry being stamped
- name: Exempt automation accounts from password expiry
  freeipa.ansible_freeipa.ipapwpolicy:
    name: automation-accounts
    priority: 1
    maxpwdlife: 0

# Clears an expiry already on the entry; policy change is not retroactive
- name: Push password expiry out
  ansible.builtin.shell:
    cmd: >-
      ipa user-mod {{ svc_ansible_principal }}
      --setattr krbPasswordExpiration=$(date -u -d '{{ ipa_automation_expiry_extend }}' +%Y%m%d%H%M%SZ)
  changed_when: true

- name: Ensure scoped automation role exists
  freeipa.ansible_freeipa.iparole:
    name: Ansible Automation
    privilege: "{{ ipa_automation_privileges }}"
    user:
      - "{{ svc_ansible_principal }}"

- name: Ensure automation keytab directory exists
  ansible.builtin.file:
    path: "{{ svc_ansible_keytab | dirname }}"
    state: directory
    owner: root
    group: root
    mode: "0700"

- name: Extract automation keytab
  ansible.builtin.command:
    cmd: >-
      ipa-getkeytab -p {{ svc_ansible_principal }}
      -k {{ svc_ansible_keytab }}
    creates: "{{ svc_ansible_keytab }}"

- name: Secure automation keytab
  ansible.builtin.file:
    path: "{{ svc_ansible_keytab }}"
    owner: root
    group: root
    mode: "0600"

- name: Limit ticket lifetime for automation account
  ansible.builtin.command:
    cmd: >-
      ipa krbtpolicy-mod {{ svc_ansible_principal }}
      --maxlife={{ ipa_automation_ticket_life }}
      --maxrenew={{ ipa_automation_ticket_life }}
  changed_when: true

- name: Switch to automation identity
  ansible.builtin.command:
    cmd: kinit -kt {{ svc_ansible_keytab }} {{ svc_ansible_principal }}
  changed_when: false
```

