**ipa.yml**

```yaml
---
- name: FreeIPA server
  hosts: ipaserver
  become: true
  gather_facts: false

  environment:
    KRB5CCNAME: "FILE:/tmp/krb5cc_ansible_ipa"

  pre_tasks:
    - name: Ensure Kerberos Python bindings present
      ansible.builtin.dnf:
        name: python3-gssapi
        state: present
      tags: [always]

  roles:
    - role: freeipa_install
      tags: [never, bootstrap]

    - role: freeipa_config
      tags: [config, bootstrap]

  post_tasks:
    - name: Destroy credential cache
      ansible.builtin.command:
        cmd: kdestroy -c FILE:/tmp/krb5cc_ansible_ipa
      changed_when: false
      failed_when: false
      tags: [always]
```

**roles/freeipa_install/defaults/main.yml**

```yaml
---
ipaserver_realm: SBOX.TEST
ipaserver_domain: sbox.test
ipa_bootstrap_vault: "{{ playbook_dir }}/vault/ipa-bootstrap.yml"
```

**roles/freeipa_install/tasks/main.yml**

```yaml
---
- name: Load bootstrap credentials
  ansible.builtin.include_vars:
    file: "{{ ipa_bootstrap_vault }}"
  no_log: true

- name: Install IPA server
  ansible.builtin.include_role:
    name: freeipa.ansible_freeipa.ipaserver
  vars:
    ipaadmin_password: "{{ enc_ipa_admin_password }}"
    ipadm_password: "{{ enc_ipa_dm_password }}"

# KDC exists only after the install above
- name: Obtain admin TGT
  ansible.builtin.shell:
    cmd: kinit admin
    stdin: "{{ enc_ipa_admin_password }}"
  no_log: true
  changed_when: false

- name: Ensure automation account exists
  freeipa.ansible_freeipa.ipauser:
    name: "{{ svc_ansible_principal }}"
    first: Ansible
    last: Automation
    password: "{{ enc_svc_ansible_password }}"
  no_log: true

# Clears the admin-set-password forced reset; must follow the task above
- name: Clear password expiry on automation account
  ansible.builtin.command:
    cmd: >-
      ipa user-mod {{ svc_ansible_principal }}
      --setattr krbPasswordExpiration=20380119031407Z
  changed_when: true

- name: Add automation account to admins
  freeipa.ansible_freeipa.ipagroup:
    name: admins
    user:
      - "{{ svc_ansible_principal }}"
    action: member

- name: Switch to automation identity
  ansible.builtin.shell:
    cmd: kinit {{ svc_ansible_principal }}
    stdin: "{{ enc_svc_ansible_password }}"
  no_log: true
  changed_when: false
```

