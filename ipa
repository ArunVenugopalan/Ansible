**roles/freeipa_config/tasks/groups.yml**

```yaml
---
- name: Ensure service role groups present
  freeipa.ansible_freeipa.ipagroup:
    name: "{{ item }}"
  loop: "{{ ipa_role_groups }}"

- name: Ensure access class groups present
  freeipa.ansible_freeipa.ipagroup:
    name: "{{ item }}"
  loop: "{{ ipa_access_groups }}"

- name: Ensure host groups present
  freeipa.ansible_freeipa.ipahostgroup:
    name: "{{ item }}"
  loop: "{{ ipa_host_groups }}"
```

**roles/freeipa_config/tasks/rbac.yml**

```yaml
---
- name: Ensure IPA roles present
  freeipa.ansible_freeipa.iparole:
    name: "{{ item.name }}"
    privilege: "{{ item.privilege }}"
    group: "{{ item.group | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
    state: present
  loop: "{{ ipa_roles }}"
  loop_control:
    label: "{{ item.name }}"
```

**roles/freeipa_config/tasks/hbac.yml**

```yaml
---
- name: Ensure HBAC rules present
  freeipa.ansible_freeipa.ipahbacrule:
    name: "{{ item.name }}"
    usergroup: "{{ item.usergroup | default(omit) }}"
    hostgroup: "{{ item.hostgroup | default(omit) }}"
    hbacsvc: "{{ item.hbacsvc | default(['sshd']) }}"
    state: present
  loop: "{{ ipa_hbac_rules }}"
  loop_control:
    label: "{{ item.name }}"

- name: Disable allow_all HBAC rule
  freeipa.ansible_freeipa.ipahbacrule:
    name: allow_all
    state: disabled
  when: ipa_disable_allow_all | bool
```

**roles/freeipa_config/tasks/sudo.yml**

```yaml
---
- name: Ensure sudo rules present
  freeipa.ansible_freeipa.ipasudorule:
    name: "{{ item.name }}"
    usergroup: "{{ item.usergroup | default(omit) }}"
    hostgroup: "{{ item.hostgroup | default(omit) }}"
    cmdcategory: "{{ item.cmdcategory | default(omit) }}"
    sudocmd: "{{ item.sudocmd | default(omit) }}"
    state: present
  loop: "{{ ipa_sudo_rules }}"
  loop_control:
    label: "{{ item.name }}"
```

**roles/freeipa_config/tasks/dns.yml**

```yaml
---
- name: Ensure DNS zones present
  freeipa.ansible_freeipa.ipadnszone:
    name: "{{ item }}"
    state: present
  loop: "{{ ipa_dns_zones }}"

- name: Ensure DNS records present
  freeipa.ansible_freeipa.ipadnsrecord:
    zone_name: "{{ item.zone }}"
    name: "{{ item.name }}"
    record_type: "{{ item.type }}"
    record_value: "{{ item.value }}"
    state: present
  loop: "{{ ipa_dns_records }}"
  loop_control:
    label: "{{ item.name }}.{{ item.zone }}"
```

