**roles/freeipa_config/tasks/auth.yml**

```yaml
---
- name: Check for automation keytab
  ansible.builtin.stat:
    path: "{{ svc_ansible_keytab }}"
  register: svc_ansible_kt

- name: Fail if realm not bootstrapped
  ansible.builtin.assert:
    that: svc_ansible_kt.stat.exists
    fail_msg: >-
      No keytab at {{ svc_ansible_keytab }}.
      Run with --tags bootstrap first.

- name: Obtain TGT from keytab
  ansible.builtin.command:
    cmd: kinit -kt {{ svc_ansible_keytab }} {{ svc_ansible_principal }}
  changed_when: false
```

